# Application Configuration Settings

# LLM Provider: 'mock' (free, offline demo) or 'openai' (uses OpenAI API)
LLM_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Scheduler Interval in Minutes (e.g. 1 for demo mode, 30 for production)
SCHEDULER_INTERVAL_MINUTES=30

# Editorial & Memory Thresholds
EDITORIAL_MIN_SCORE=20.0
MEMORY_SIMILARITY_THRESHOLD=0.65

# Database Connection (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite+aiosqlite:///./autonomous_agent.db
